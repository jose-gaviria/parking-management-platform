# PostgreSQL (local development)
DATABASE_URL=postgresql://parking:change-me@localhost:5433/parking?schema=public
POSTGRES_USER=parking
POSTGRES_PASSWORD=change-me
POSTGRES_DB=parking
POSTGRES_PORT=5433

# API
API_PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3001

# Web
WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:4000

# Ticketing and billing
BILLING_PROVIDER=none
TICKET_PREFIX=PK
TICKET_SIGNING_SECRET=replace-with-a-separate-random-secret

# Demo seed — choose local values; never reuse production credentials
SEED_ADMIN_PASSWORD=choose-a-local-demo-password
SEED_ADMIN_PIN=choose-a-local-pin
SEED_SUPERVISOR_PASSWORD=choose-a-local-demo-password
SEED_SUPERVISOR_PIN=choose-a-local-pin
SEED_OPERATOR_PASSWORD=choose-a-local-demo-password
SEED_AUDITOR_PASSWORD=choose-a-local-demo-password
