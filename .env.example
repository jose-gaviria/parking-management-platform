# PostgreSQL (local development)
DATABASE_URL=postgresql://parking:change-me@localhost:5433/parking?schema=public
# Conexión directa, sin pooling, usada solo por las migraciones de Prisma.
# En local es idéntica a DATABASE_URL; en Neon/Vercel es la variante *_UNPOOLED.
DATABASE_URL_UNPOOLED=postgresql://parking:change-me@localhost:5433/parking?schema=public
POSTGRES_USER=parking
POSTGRES_PASSWORD=change-me
POSTGRES_DB=parking
POSTGRES_PORT=5433

# API
API_PORT=4000
# Obligatoria, mínimo 32 caracteres. Sin ella la API no arranca.
# Generar con: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-of-32-chars-or-more
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3001
# 1 detrás de un proxy inverso (Vercel, Nginx): permite ver la IP real del
# cliente en el rate limiting y en la auditoría de terminal.
TRUST_PROXY=0
# Swagger (/docs) se publica solo fuera de producción; 1 lo fuerza igualmente.
ENABLE_SWAGGER=0

# Web
WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:4000

# Ticketing and billing
BILLING_PROVIDER=none
TICKET_PREFIX=PK
TICKET_SIGNING_SECRET=replace-with-a-separate-random-secret

# Demo público (opcional): acceso fijo que se muestra en el inicio de sesión.
# Solo en despliegues de demostración; una instalación real NO las define.
# DEMO_USERNAME=demo
# DEMO_PASSWORD=choose-a-public-demo-password

# Demo seed — choose local values; never reuse production credentials
SEED_ADMIN_PASSWORD=choose-a-local-demo-password
SEED_ADMIN_PIN=choose-a-local-pin
SEED_SUPERVISOR_PASSWORD=choose-a-local-demo-password
SEED_SUPERVISOR_PIN=choose-a-local-pin
SEED_OPERATOR_PASSWORD=choose-a-local-demo-password
SEED_AUDITOR_PASSWORD=choose-a-local-demo-password
